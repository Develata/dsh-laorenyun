{
  "name": "dsh-laorenyun",
  "version": "0.2.0-rc.3",
  "description": "Laorenyun source archive and interview foundation for pinned DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./interviewer": {
      "types": "./lib/types/host/interviewer.d.ts",
      "default": "./lib/interviewer.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build": "tsc -p tsconfig.declarations.host.json && tsc -p tsconfig.declarations.client.json && node scripts/build.mjs",
    "test": "node --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "format:check": "prettier --check src tests scripts *.json cordis.patch.yml"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-brand": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "tencentcloud-sdk-nodejs-common": "4.1.220",
    "tencentcloud-sdk-nodejs-tts": "4.1.237"
  }
}
